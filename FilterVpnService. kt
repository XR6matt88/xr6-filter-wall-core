package com.xr6labs.filterwall

import android.content.Intent
import android.net.VpnService
import android.os.ParcelFileDescriptor
import com.chaquo.python.Python
import java.io.FileInputStream
import java.io.FileOutputStream
import java.nio.ByteBuffer

class FilterVpnService : VpnService() {
    private var vpnInterface: ParcelFileDescriptor? = null
    private var isRunning = false

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        if (!isRunning) {
            isRunning = true
            val builder = Builder()
                .setSession("XR6 Filter Wall")
                .addAddress("10.0.0.2", 32)
                .addRoute("0.0.0.0", 0)
                .addDnsServer("1.1.1.1")
            vpnInterface = builder.establish()
            Thread { processPackets() }.start()
        }
        return START_STICKY
    }

    private fun processPackets() {
        val py = Python.getInstance()
        val bridge = py.getModule("bridge")
        val input = FileInputStream(vpnInterface?.fileDescriptor)
        val output = FileOutputStream(vpnInterface?.fileDescriptor)
        val buffer = ByteBuffer.allocate(32767)

        while (isRunning) {
            val length = input.read(buffer.array())
            if (length > 0) {
                // Ekstrak domain/SNI daripada pengepala IP/TLS
                val extractedSni = extractTlsSni(buffer.array(), length)
                val result = bridge.callAttr(
                    "inspect_from_android",
                    "pkt-${System.nanoTime()}",
                    extractedSni,
                    extractedSni,
                    null
                ).asMap()

                val permitted = result[py.builtins.callAttr("str", "permitted")]?.toBoolean() ?: true
                if (permitted) {
                    output.write(buffer.array(), 0, length)
                }
                buffer.clear()
            }
        }
    }

    private fun extractTlsSni(packet: ByteArray, length: Int): String {
        // Penghurai ringkas TLS ClientHello SNI
        return ""
    }

    override fun onDestroy() {
        isRunning = false
        vpnInterface?.close()
        super.onDestroy()
    }
}
